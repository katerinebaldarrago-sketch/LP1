#include <iostream>
#include <math.h>
using namespace std;

int main(){
    float a,b,h;
    cout << "sistema de calculo de hipotenusa de un triangulo rectangulo!" << endl;
    cout << "ingrese el valor del cateto a "<< endl;cin >> a;
    cout << "ingrese el valor del cateto b "<< endl;cin >> b;
    h = sqrt(pow(a,2)+pow(b,2));
    cout << "La Hipotenusa es: " << h<< endl;
    return 0;
}
